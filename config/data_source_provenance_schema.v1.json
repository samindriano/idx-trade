{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samindriano/idx-trade/schema/data-source-provenance-v1.json",
  "title": "IDX Trade data-source provenance registry",
  "description": "Evidence-bound registry. Validation is fail-closed and does not promote unresolved PIT semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "as_of", "source_count", "checkpoint_count", "controlling_checkpoints", "sources", "maintenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "as_of": {"$ref": "#/$defs/date"},
    "source_count": {"type": "integer", "minimum": 0},
    "checkpoint_count": {"type": "integer", "minimum": 0},
    "controlling_checkpoints": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "review_cadence", "rules"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "review_cadence": {"type": "string", "minLength": 1},
        "rules": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "status", "repository", "git_ref", "commit", "path", "blob_sha1", "accepted_claims", "notes"],
      "properties": {
        "checkpoint_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["CONTROLLING", "SUPERSEDED", "RETIRED"]},
        "repository": {"$ref": "#/$defs/nonEmptyString"},
        "git_ref": {"$ref": "#/$defs/nonEmptyString"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\].*$"},
        "blob_sha1": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "accepted_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "notes": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end", "unit", "scope", "completeness", "notes"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonEmptyString"},
        "start": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "end": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "unit": {"$ref": "#/$defs/nonEmptyString"},
        "scope": {"$ref": "#/$defs/nonEmptyString"},
        "completeness": {"$ref": "#/$defs/nonEmptyString"},
        "notes": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "timingStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "field", "timezone", "semantics"],
      "properties": {
        "status": {"enum": ["EXPLICIT", "SESSION_DATE", "CAPTURE_DATE", "CAPTURE_TIME_RECORDED", "DERIVED_NOT_EFFECTIVE", "UNKNOWN", "NOT_APPLICABLE", "NOT_ESTABLISHED"]},
        "field": {"anyOf": [{"$ref": "#/$defs/nonEmptyString"}, {"type": "null"}]},
        "timezone": {"$ref": "#/$defs/nonEmptyString"},
        "semantics": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_date", "publication", "observation"],
      "properties": {
        "effective_date": {"$ref": "#/$defs/timingStatus"},
        "publication": {"$ref": "#/$defs/timingStatus"},
        "observation": {"$ref": "#/$defs/timingStatus"}
      }
    },
    "revisionRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "versioning", "overwrite_policy", "notes"],
      "properties": {
        "level": {"enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN", "NOT_APPLICABLE"]},
        "versioning": {"enum": ["IMMUTABLE", "VINTAGED", "UNVINTAGED", "NOT_APPLICABLE", "UNKNOWN"]},
        "overwrite_policy": {"enum": ["APPEND_ONLY", "PRESERVE_VERSIONS", "CREATE_ONCE", "NO_OVERWRITE", "NOT_APPLICABLE", "UNKNOWN"]},
        "notes": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "artifactHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "algorithm", "hash", "location", "immutable"],
      "properties": {
        "label": {"$ref": "#/$defs/nonEmptyString"},
        "algorithm": {"enum": ["sha1", "sha256"]},
        "hash": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "location": {"$ref": "#/$defs/nonEmptyString"},
        "immutable": {"type": "boolean"}
      }
    },
    "rawProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_method", "raw_bytes_status", "canonical_locators", "transport_locators", "artifact_hashes", "preservation"],
      "properties": {
        "retrieval_method": {"$ref": "#/$defs/nonEmptyString"},
        "raw_bytes_status": {"$ref": "#/$defs/nonEmptyString"},
        "canonical_locators": {"$ref": "#/$defs/stringList"},
        "transport_locators": {"$ref": "#/$defs/stringList"},
        "artifact_hashes": {"type": "array", "items": {"$ref": "#/$defs/artifactHash"}},
        "preservation": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes", "superseded_by", "authority_over", "transport_for"],
      "properties": {
        "supersedes": {"$ref": "#/$defs/stringList"},
        "superseded_by": {"$ref": "#/$defs/stringList"},
        "authority_over": {"$ref": "#/$defs/stringList"},
        "transport_for": {"$ref": "#/$defs/stringList"}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "last_reviewed", "stale_after_days"],
      "properties": {
        "policy": {"$ref": "#/$defs/nonEmptyString"},
        "last_reviewed": {"$ref": "#/$defs/date"},
        "stale_after_days": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "family", "name", "provider", "authority", "authority_role", "status", "granularity", "coverage", "timing", "pit_status", "revision_risk", "raw_provenance", "permitted_uses", "prohibited_uses", "controlling_checkpoint_ids", "unresolved_findings", "supersession", "freshness", "notes"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "family": {"$ref": "#/$defs/nonEmptyString"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "provider": {"$ref": "#/$defs/nonEmptyString"},
        "authority": {"enum": ["OFFICIAL_IDX", "OFFICIAL_KSEI", "OFFICIAL_ISSUER", "OFFICIAL_CSD", "OFFICIAL_REGULATOR", "MIXED_OFFICIAL", "SECONDARY_PROVIDER", "SECONDARY_TRANSPORT", "DERIVED", "UNKNOWN"]},
        "authority_role": {"enum": ["PRIMARY_AUTHORITY", "SECONDARY_TRANSPORT", "CROSS_CHECK", "DERIVED_RESEARCH", "DISCOVERY_LAYER", "MIXED"]},
        "status": {"enum": ["CERTIFIED_BOUNDED", "ACCEPTED_CONDITIONAL", "DISCOVERY_ONLY", "AUDIT_ONLY", "SHADOW", "BLOCKED", "REJECTED", "PARKED", "AUTOMATED_FORWARD"]},
        "granularity": {"$ref": "#/$defs/nonEmptyString"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "timing": {"$ref": "#/$defs/timing"},
        "pit_status": {"enum": ["PIT_CERTIFIED", "PIT_PARTIAL", "PIT_UNRESOLVED", "PIT_BLOCKED", "NOT_PIT", "UNKNOWN"]},
        "revision_risk": {"$ref": "#/$defs/revisionRisk"},
        "raw_provenance": {"$ref": "#/$defs/rawProvenance"},
        "permitted_uses": {"$ref": "#/$defs/stringList"},
        "prohibited_uses": {"$ref": "#/$defs/stringList"},
        "controlling_checkpoint_ids": {"$ref": "#/$defs/stringList"},
        "unresolved_findings": {"$ref": "#/$defs/stringList"},
        "supersession": {"$ref": "#/$defs/supersession"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "notes": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
