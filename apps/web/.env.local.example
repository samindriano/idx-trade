# Copy to apps/web/.env.local on the trusted local workstation.
# Do not commit the real local paths.

IDX_TRADE_RUNTIME_ROOT=D:\\path\\to\\idx-trade-data-gate
IDX_TRADE_PYTHON=C:\\path\\to\\python.exe

# Optional: defaults to <runtime parent>\\stockbit_intraday_recurring_v1.
IDX_TRADE_STOCKBIT_RUNTIME_ROOT=D:\\path\\to\\stockbit_intraday_recurring_v1
IDX_TRADE_STOCKBIT_TASK_NAME=IDX-Trade Stockbit Intraday Daily
