{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idx-trade-artifact-registry-v1",
  "type": "object",
  "required": ["registry_id", "schema_version", "inventory_snapshot", "external_root_convention", "promotion_run", "promoted_artifacts", "groups"],
  "properties": {
    "registry_id": {"const": "idx-trade-artifact-registry-v1"},
    "schema_version": {"const": 1},
    "inventory_snapshot": {
      "type": "object",
      "required": ["repository_commit", "scanned_at", "external_roots_scanned"],
      "properties": {
        "repository": {"type": "string"},
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch_context": {"type": "string"},
        "scanned_at": {"type": "string", "format": "date-time"},
        "tracked_files": {"type": "integer", "minimum": 0},
        "tracked_data_or_model_binaries": {"type": "integer", "minimum": 0},
        "largest_tracked_file_bytes": {"type": "integer", "minimum": 0},
        "external_scan_scope": {"type": "string"},
        "external_roots_scanned": {"type": "integer", "minimum": 0},
        "external_files_scanned": {"type": "integer", "minimum": 0},
        "external_bytes_scanned": {"type": "integer", "minimum": 0},
        "external_size_gb_approx": {"type": "number", "minimum": 0},
        "primary_worktree_untracked_frontend_excluded": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "external_root_convention": {
      "type": "object",
      "required": ["root_key", "absolute_path_is_git_forbidden", "registry_path_form"],
      "properties": {
        "root_key": {"const": "IDX_TRADE_EXTERNAL_ROOT"},
        "absolute_path_is_git_forbidden": {"const": true},
        "registry_path_form": {"const": "external_root_key + relative_path"}
      },
      "additionalProperties": false
    },
    "promotion_run": {
      "type": "object",
      "required": ["promotion_id", "source_main_commit", "source_selection_commit", "source_acceptance_ref", "source_external_root_key", "source_external_snapshot", "selection_policy", "duplicate_policy", "promoted_count", "promoted_bytes", "external_payloads_not_promoted"],
      "properties": {
        "promotion_id": {"type": "string"},
        "source_main_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_selection_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_acceptance_ref": {"type": "string"},
        "source_external_root_key": {"const": "IDX_TRADE_EXTERNAL_ROOT"},
        "source_external_snapshot": {"type": "string"},
        "selection_policy": {"type": "string"},
        "duplicate_policy": {"type": "string"},
        "promoted_count": {"type": "integer", "minimum": 1},
        "promoted_bytes": {"type": "integer", "minimum": 1},
        "external_payloads_not_promoted": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "promoted_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "classification", "source_lane", "source_status", "source_acceptance_ref", "source_external_root_key", "source_relative_path", "git_path", "source_size_bytes", "promoted_size_bytes", "source_sha256", "promoted_sha256", "promotion_status", "promotion_method", "duplicate_status", "stale_status", "payload_type"],
        "properties": {
          "artifact_id": {"type": "string"},
          "classification": {"enum": ["PUSH_TO_GIT", "PUSH_SUMMARY_OR_MANIFEST_ONLY"]},
          "source_lane": {"type": "string"},
          "source_status": {"type": "string"},
          "source_acceptance_ref": {"type": "string"},
          "source_external_root_key": {"const": "IDX_TRADE_EXTERNAL_ROOT"},
          "source_relative_path": {"type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*\\\\).+"},
          "git_path": {"type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*\\\\).+"},
          "source_size_bytes": {"type": "integer", "minimum": 0},
          "promoted_size_bytes": {"type": "integer", "minimum": 0},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "promoted_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "promotion_status": {"const": "PROMOTED"},
          "promotion_method": {"enum": ["EXACT_COPY", "SCRUBBED_POINTER"]},
          "duplicate_status": {"enum": ["UNIQUE", "EXACT_DUPLICATE"]},
          "duplicate_of": {"type": "string"},
          "stale_status": {"const": "CURRENT"},
          "payload_type": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "recommended_action", "scope", "reason"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "recommended_action": {"enum": ["PUSH_TO_GIT", "KEEP_EXTERNAL", "PUSH_SUMMARY_OR_MANIFEST_ONLY"]},
          "scope": {"type": "string"},
          "root_patterns": {"type": "array", "items": {"type": "string"}},
          "observed_roots": {"type": "integer", "minimum": 0},
          "observed_files": {"type": "integer", "minimum": 0},
          "approx_bytes": {"type": "integer", "minimum": 0},
          "reason": {"type": "string"},
          "examples": {"type": "array", "items": {"type": "string"}},
          "payload_policy": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
