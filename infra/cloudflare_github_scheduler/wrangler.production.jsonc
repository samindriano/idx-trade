{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "idx-trade-github-scheduler-v1",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "vars": {
    "GITHUB_OWNER": "samindriano",
    "GITHUB_REPO": "idx-trade",
    "GITHUB_REF": "main",
    "DISPATCH_MODE": "active",
    "E2E_EXPECTED_CODE_COMMIT": "8bc3ee3efd65e8b16478e404e4b226451b105c48",
    "OFFICIAL_OPEN_EXPECTED_CODE_COMMIT": "ac29a0552b1785045906f8d608b5371d93e01b73"
  },
  "secrets": {
    "required": ["GITHUB_ACTIONS_TOKEN", "OFFICIAL_OPEN_SCHEDULER_HMAC_KEY"]
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "idx-trade-stockbit-stream-v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "SchedulerCoordinator"
      }
    ]
  },
  "exports": {
    "SchedulerCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "35,50 1 * * 1-5",
      "0,5,15,22 2 * * 1-5",
      "40 11 * * 1-5",
      "10,40 12 * * 1-5",
      "40 13 * * 1-5"
    ]
  }
}