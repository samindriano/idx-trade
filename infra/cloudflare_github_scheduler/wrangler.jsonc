{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "idx-trade-github-scheduler-v1-staging-observe",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "vars": {
    "GITHUB_OWNER": "samindriano",
    "GITHUB_REPO": "idx-trade",
    "GITHUB_REF": "main",
    "DISPATCH_MODE": "observe_only",
    "E2E_EXPECTED_CODE_COMMIT": "82007457522d6e268de8bd6e1b75762fb76accfe"
  },
  "secrets": {
    "required": ["GITHUB_ACTIONS_READ_TOKEN"]
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "idx-trade-stockbit-stream-v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "SchedulerCoordinator"
      }
    ]
  },
  "exports": {
    "SchedulerCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": []
  }
}
